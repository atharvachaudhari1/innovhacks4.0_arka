{
  "cleanUrls": true,
  "headers": [
    {
      "source": "/downloads/(.*).apk",
      "headers": [
        { "key": "Content-Type", "value": "application/vnd.android.package-archive" },
        { "key": "Content-Disposition", "value": "attachment; filename=\"FitGuru-Android.apk\"" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/download-android", "destination": "/downloads/FitGuru-Android.apk" },
    { "source": "/download-apk", "destination": "/downloads/FitGuru-Android.apk" },
    { "source": "/download-ios", "destination": "/downloads/FitGuru-iOS.ipa" }
  ]
}
