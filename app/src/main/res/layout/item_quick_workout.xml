<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="160dp"
    android:layout_height="wrap_content"
    android:layout_marginEnd="12dp"
    app:cardBackgroundColor="@color/card_background"
    app:cardCornerRadius="16dp"
    app:cardElevation="0dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?android:attr/selectableItemBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/card_border_bg"
        android:orientation="vertical"
        android:padding="14dp">

        <TextView
            android:id="@+id/quick_icon"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/avatar_glow_bg"
            android:gravity="center"
            android:text="🏋️"
            android:textSize="20sp" />

        <TextView
            android:id="@+id/quick_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Squats"
            android:textColor="@color/white"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/quick_desc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Quads • Glutes"
            android:textColor="@color/accent_lime"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/quick_tag"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/badge_smartwatch_bg"
            android:paddingStart="6dp"
            android:paddingTop="2dp"
            android:paddingEnd="6dp"
            android:paddingBottom="2dp"
            android:text="AI TRACKER"
            android:textColor="@color/accent_lime"
            android:textSize="9sp"
            android:textStyle="bold" />

    </LinearLayout>
</androidx.cardview.widget.CardView>
